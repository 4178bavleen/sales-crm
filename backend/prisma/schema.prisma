generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum ReasonType {
  LEAD_DISQUALIFIED
  DEAL_LOST
  TASK_CANCELLED
  NO_FOLLOWUP
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CALL
  MESSAGE
  EMAIL
  REMINDER
  OTHER
}

enum MeetingStatus {
  PLANNED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DocumentCategory {
  PROPOSAL
  CONTRACT
  MEETING_NOTES
  CUSTOMER_FILE
  OTHER
}

enum TargetPeriod {
  MONTHLY
  QUARTERLY
}

enum ImportSource {
  EXCEL
  GOOGLE_SHEETS
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  IMPORTED
  SKIPPED
  FAILED
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum TransactionPaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  OTHER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  WEEKEND
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
  PATERNITY
  COMP_OFF
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveAccrualPeriod {
  YEARLY
  HALF_YEARLY
  QUARTERLY
  MONTHLY
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

// ---------------------------------------------------------------------
// 1. USERS & ACCESS
// ---------------------------------------------------------------------

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // ADMIN, SALES_MANAGER, SALES_EMPLOYEE, REPORT_VIEWER
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// e.g. users.manage, records.delete, data.export, revenue.view, deals.edit_closed
model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  managerId Int?
  createdAt DateTime @default(now())

  manager User?           @relation("TeamManager", fields: [managerId], references: [id])
  members User[]          @relation("TeamMembers")
  targets RevenueTarget[]

  @@map("teams")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  roleId       Int
  teamId       Int?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  joiningDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  role Role  @relation(fields: [roleId], references: [id])
  team Team? @relation("TeamMembers", fields: [teamId], references: [id])

  managedTeams Team[] @relation("TeamManager")

  createdLeads        Lead[]               @relation("LeadCreatedBy")
  ownedLeads          Lead[]               @relation("LeadOwner")
  assignmentsReceived LeadAssignment[]     @relation("AssignedTo")
  assignmentsMade     LeadAssignment[]     @relation("AssignedBy")
  ownedCustomers      Customer[]           @relation("CustomerOwner")
  ownedDeals          Deal[]               @relation("DealOwner")
  createdDeals        Deal[]               @relation("DealCreatedBy")
  stageChanges        DealStageHistory[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  completedTasks      Task[]               @relation("TaskCompleter")
  activities          Activity[]
  organizedMeetings   Meeting[]            @relation("MeetingOrganizer")
  meetingsAttending   MeetingParticipant[]
  uploadedDocuments   Document[]
  documentVersions    DocumentVersion[]
  targets             RevenueTarget[]      @relation("TargetEmployee")
  targetsCreated      RevenueTarget[]      @relation("TargetCreator")
  targetChanges       TargetChange[]
  importBatches       ImportBatch[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  ownedProposals      Proposal[]           @relation("ProposalOwner")
  createdProposals    Proposal[]           @relation("ProposalCreatedBy")
  approvedProposals   Proposal[]           @relation("ProposalApprovedBy")
  facebookDefaultOwners FacebookSetting[]  @relation("FacebookDefaultOwner")
  financialTransactions FinancialTransaction[] @relation("TransactionCreatedBy")
  invoicesCreated       Invoice[]              @relation("InvoiceCreatedBy")
  phones                EmployeePhone[]
  employeeProfile       EmployeeProfile?
  hrManagedProfiles     EmployeeProfile[]      @relation("EmployeeManager")
  hrHeadedDepartments   HrDepartment[]         @relation("HRDepartmentHead")
  hrAttendance          Attendance[]           @relation("HRAttendance")
  hrLeaveRequests       LeaveRequest[]         @relation("HRLeaveEmployee")
  hrApprovedLeaves      LeaveRequest[]         @relation("HRLeaveApprover")
  hrPayrollRecords      PayrollRecord[]        @relation("HRPayroll")
  hrDocuments           EmployeeDocument[]     @relation("HRDocument")

  @@index([roleId])
  @@index([teamId])
  @@map("users")
}

model EmployeePhone {
  id          Int      @id @default(autoincrement())
  userId      Int
  countryCode String
  dialCode    String
  number      String
  label       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("employee_phones")
}

model HrDepartment {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  headUserId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  head         User?            @relation("HRDepartmentHead", fields: [headUserId], references: [id])
  profiles     EmployeeProfile[]
  designations HrDesignation[]

  @@map("hr_departments")
}

model HrDesignation {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  departmentId Int?
  level        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department HrDepartment?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  profiles   EmployeeProfile[]

  @@index([departmentId])
  @@map("hr_designations")
}

model EmployeeProfile {
  id                     Int            @id @default(autoincrement())
  userId                 Int            @unique
  employeeCode           String?        @unique
  departmentId           Int?
  designationId          Int?
  managerId              Int?
  employmentType         EmploymentType @default(FULL_TIME)
  workLocation           String?
  shiftStart             String?
  shiftEnd               String?
  dateOfBirth            DateTime?      @db.Date
  gender                 Gender?
  maritalStatus          MaritalStatus?
  nationality            String?
  bloodGroup             String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  postalCode             String?
  countryCode            String?        @default("IN")
  emergencyContactName   String?
  emergencyContactPhone  String?
  bankName               String?
  bankAccountNumber      String?
  bankIfscCode           String?
  taxId                  String?
  salary                 Decimal?       @db.Decimal(14, 2)
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation HrDesignation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager     User?         @relation("EmployeeManager", fields: [managerId], references: [id])

  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@map("employee_profiles")
}

model Attendance {
  id             Int              @id @default(autoincrement())
  userId         Int
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  workingMinutes Int              @default(0)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation("HRAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("hr_attendance")
}

model LeaveTypePolicy {
  id                  Int                 @id @default(autoincrement())
  name                String              @unique
  code                String              @unique
  quota               Decimal             @default(12.0) @db.Decimal(5, 1)
  period              LeaveAccrualPeriod  @default(YEARLY)
  isPaid              Boolean             @default(true)
  requiresDocument    Boolean             @default(false)
  documentDescription String?
  description         String?
  isActive            Boolean             @default(true)
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  leaveRequests       LeaveRequest[]

  @@map("leave_type_policies")
}

model LeaveRequest {
  id              Int              @id @default(autoincrement())
  userId          Int
  leaveType       String
  policyId        Int?
  policy          LeaveTypePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date
  reason          String?
  documentPath    String?
  documentName    String?
  documentType    String?
  rejectionReason String?
  status          LeaveStatus      @default(PENDING)
  approvedById    Int?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user       User  @relation("HRLeaveEmployee", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("HRLeaveApprover", fields: [approvedById], references: [id])

  @@index([userId, status])
  @@index([policyId])
  @@map("hr_leave_requests")
}

model PayrollRecord {
  id          Int           @id @default(autoincrement())
  userId      Int
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  basic       Decimal       @default(0) @db.Decimal(14, 2)
  allowances  Decimal       @default(0) @db.Decimal(14, 2)
  deductions  Decimal       @default(0) @db.Decimal(14, 2)
  grossPay    Decimal       @default(0) @db.Decimal(14, 2)
  netPay      Decimal       @default(0) @db.Decimal(14, 2)
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation("HRPayroll", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd])
  @@index([status])
  @@map("hr_payroll_records")
}

model EmployeeDocument {
  id          Int       @id @default(autoincrement())
  userId      Int
  type        String
  name        String?
  filePath    String?
  issuedAt    DateTime? @db.Date
  expiresAt   DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation("HRDocument", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("hr_employee_documents")
}

// ---------------------------------------------------------------------
// 2. MASTER DATA
// ---------------------------------------------------------------------

model LeadSource {
  id       Int     @id @default(autoincrement())
  name     String  @unique // Website, Referral, Excel Import, Google Sheet, ...
  isActive Boolean @default(true)
  leads    Lead[]

  @@map("lead_sources")
}

model ProductService {
  id          Int                @id @default(autoincrement())
  name        String             @unique @db.VarChar(200)
  description String?            @db.Text
  hsnCode     String?            @db.VarChar(50)
  type        ProductServiceType @default(PRODUCT)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  leads Lead[]
  deals Deal[]
  proposalItems ProposalItem[]
  invoiceItems InvoiceItem[]

  @@index([type, isActive])
  @@index([hsnCode])
  @@map("products_services")
}

// Predefined reasons for: disqualified lead, lost deal, cancelled task, "no follow-up needed"
model Reason {
  id       Int        @id @default(autoincrement())
  type     ReasonType
  name     String
  isActive Boolean    @default(true)

  disqualifiedLeads Lead[] @relation("LeadDisqualifyReason")
  lostDeals         Deal[] @relation("DealLostReason")
  cancelledTasks    Task[] @relation("TaskCancelReason")

  @@unique([type, name])
  @@map("reasons")
}

model PipelineStage {
  id       Int       @id @default(autoincrement())
  name     String    @unique // Qualified, Meeting/Demo, Proposal, Negotiation, Won, Lost
  position Int       @unique
  kind     StageKind @default(OPEN)
  isActive Boolean   @default(true)

  deals       Deal[]
  historyFrom DealStageHistory[] @relation("StageFrom")
  historyTo   DealStageHistory[] @relation("StageTo")

  @@map("pipeline_stages")
}

// ---------------------------------------------------------------------
// 3. COMPANIES, CONTACTS, CUSTOMERS
// ---------------------------------------------------------------------

model Company {
  id             Int        @id @default(autoincrement())
  name           String
  normalizedName String // lower-case, trimmed, no suffixes (Pvt/Ltd) -> duplicate check
  website        String?
  industry       String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  contacts       Contact[]
  customers      Customer[]
  leads          Lead[]
  tasks          Task[]
  activities     Activity[]
  meetings       Meeting[]
  documents      Document[]

  @@index([normalizedName])
  @@map("companies")
}

model Contact {
  id              Int       @id @default(autoincrement())
  companyId       Int?
  fullName        String
  jobTitle        String?
  email           String?
  normalizedEmail String? // lower-case
  phone           String?
  normalizedPhone String? // digits only
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  company          Company?             @relation(fields: [companyId], references: [id])
  leads            Lead[]
  primaryFor       Customer[]           @relation("CustomerPrimaryContact")
  meetingsAttended MeetingParticipant[]

  @@index([companyId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@map("contacts")
}

// Created when a qualified lead is converted. The lead is kept (history stays).
model Customer {
  id               Int       @id @default(autoincrement())
  companyId        Int?
  primaryContactId Int?
  ownerId          Int?
  convertedAt      DateTime  @default(now())
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  company        Company? @relation(fields: [companyId], references: [id])
  primaryContact Contact? @relation("CustomerPrimaryContact", fields: [primaryContactId], references: [id])
  owner          User?    @relation("CustomerOwner", fields: [ownerId], references: [id])

  convertedFromLeads Lead[]
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  meetings           Meeting[]
  documents          Document[]
  proposals          Proposal[]
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]

  @@index([companyId])
  @@index([ownerId])
  @@map("customers")
}

// ---------------------------------------------------------------------
// 4. LEADS
// ---------------------------------------------------------------------

model Lead {
  id                Int     @id @default(autoincrement())
  contactName       String
  companyName       String?
  phone             String?
  email             String?
  normalizedPhone   String? // digits only
  normalizedEmail   String? // lower-case
  normalizedCompany String?

  sourceId         Int?
  productServiceId Int?
  priority         Priority   @default(MEDIUM)
  status           LeadStatus @default(NEW)
  notes            String?

  createdById Int
  ownerId     Int? // current assignee (full history in lead_assignments)

  // disqualified leads need a reason (CHECK constraint in DB_DESIGN.md)
  disqualifyReasonId Int?
  disqualifyNote     String?
  disqualifiedAt     DateTime?

  // every active lead: next follow-up date OR a note why none is needed
  nextFollowUpAt     DateTime?
  noFollowUpNote     String?

  // links (filled as the lead matures)
  contactId           Int?
  companyId           Int?
  convertedCustomerId Int?
  convertedAt         DateTime?
  importRowId         Int?      @unique
  facebookLeadId      String?   @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  source            LeadSource?     @relation(fields: [sourceId], references: [id])
  productService    ProductService? @relation(fields: [productServiceId], references: [id])
  createdBy         User            @relation("LeadCreatedBy", fields: [createdById], references: [id])
  owner             User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  disqualifyReason  Reason?         @relation("LeadDisqualifyReason", fields: [disqualifyReasonId], references: [id])
  contact           Contact?        @relation(fields: [contactId], references: [id])
  company           Company?        @relation(fields: [companyId], references: [id])
  convertedCustomer Customer?       @relation(fields: [convertedCustomerId], references: [id])
  importRow         ImportRow?      @relation("ImportRowLead", fields: [importRowId], references: [id])

  assignments LeadAssignment[]
  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  meetings    Meeting[]
  documents   Document[]
  proposals   Proposal[]

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@index([sourceId])
  @@index([nextFollowUpAt])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedCompany])
  @@map("leads")
}

// One row per assignment. The current one has unassignedAt = NULL.
model LeadAssignment {
  id           Int       @id @default(autoincrement())
  leadId       Int
  assignedToId Int
  assignedById Int
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  note         String?

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([leadId, assignedAt])
  @@index([assignedToId])
  @@map("lead_assignments")
}

// ---------------------------------------------------------------------
// 5. DEALS (Pipeline)
// ---------------------------------------------------------------------

model Deal {
  id               Int        @id @default(autoincrement())
  name             String
  leadId           Int?
  customerId       Int?
  ownerId          Int
  createdById      Int
  productServiceId Int?
  stageId          Int
  status           DealStatus @default(OPEN) // kept separate from lead status

  estimatedValue    Decimal   @db.Decimal(14, 2) // pipeline value, NOT revenue
  expectedCloseDate DateTime? @db.Date

  nextAction      String?
  nextActionDueAt DateTime?
  stageEnteredAt  DateTime  @default(now()) // for "time in stage" / stale-deal highlight
  lastActivityAt  DateTime?

  // closed revenue - only set when the agreed business rule is met
  closedAt      DateTime?
  closedRevenue Decimal?  @db.Decimal(14, 2)
  lostReasonId  Int?
  lostNote      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lead           Lead?           @relation(fields: [leadId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  owner          User            @relation("DealOwner", fields: [ownerId], references: [id])
  createdBy      User            @relation("DealCreatedBy", fields: [createdById], references: [id])
  productService ProductService? @relation(fields: [productServiceId], references: [id])
  stage          PipelineStage   @relation(fields: [stageId], references: [id])
  lostReason     Reason?         @relation("DealLostReason", fields: [lostReasonId], references: [id])

  stageHistory DealStageHistory[]
  tasks        Task[]
  activities   Activity[]
  meetings     Meeting[]
  documents    Document[]
  proposals    Proposal[]
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]

  @@index([ownerId, status])
  @@index([stageId, status])
  @@index([status, closedAt])
  @@index([leadId])
  @@index([customerId])
  @@index([expectedCloseDate])
  @@map("deals")
}

model DealStageHistory {
  id          Int      @id @default(autoincrement())
  dealId      Int
  fromStageId Int?
  toStageId   Int
  changedById Int
  changedAt   DateTime @default(now())
  note        String?

  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage PipelineStage? @relation("StageFrom", fields: [fromStageId], references: [id])
  toStage   PipelineStage  @relation("StageTo", fields: [toStageId], references: [id])
  changedBy User           @relation(fields: [changedById], references: [id])

  @@index([dealId, changedAt])
  @@map("deal_stage_history")
}

// ---------------------------------------------------------------------
// 6. TASKS & ACTIVITIES (follow-ups)
// Exactly one of leadId / dealId / customerId / companyId is set
// (CHECK constraint in DB_DESIGN.md).
// ---------------------------------------------------------------------

model Task {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  assignedToId Int
  createdById  Int
  dueAt        DateTime
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(OPEN)

  completedAt     DateTime?
  completedById   Int?
  completionNote  String?
  cancelReasonId  Int?
  rescheduleCount Int       @default(0)

  leadId     Int?
  dealId     Int?
  customerId Int?
  companyId  Int?
  meetingId  Int? // task created from a meeting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo   User      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User      @relation("TaskCreator", fields: [createdById], references: [id])
  completedBy  User?     @relation("TaskCompleter", fields: [completedById], references: [id])
  cancelReason Reason?   @relation("TaskCancelReason", fields: [cancelReasonId], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id])
  deal         Deal?     @relation(fields: [dealId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  company      Company?  @relation(fields: [companyId], references: [id])
  meeting      Meeting?  @relation("MeetingFollowUpTasks", fields: [meetingId], references: [id])
  rescheduleHistory TaskRescheduleHistory[]

  activities Activity[]

  @@index([assignedToId, status, dueAt]) // today / overdue / upcoming lists
  @@index([leadId])
  @@index([dealId])
  @@index([customerId])
  @@index([companyId])
  @@map("tasks")
}

// Logged calls, messages, emails, reminders and their outcomes
model Activity {
  id            Int          @id @default(autoincrement())
  type          ActivityType
  outcome       String?
  notes         String?
  occurredAt    DateTime     @default(now())
  performedById Int

  leadId     Int?
  dealId     Int?
  customerId Int?
  companyId  Int?
  taskId     Int?

  createdAt DateTime @default(now())

  performedBy User      @relation(fields: [performedById], references: [id])
  lead        Lead?     @relation(fields: [leadId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  company     Company?  @relation(fields: [companyId], references: [id])
  task        Task?     @relation(fields: [taskId], references: [id])

  @@index([leadId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([performedById])
  @@map("activities")
}

// ---------------------------------------------------------------------
// 7. MEETINGS
// ---------------------------------------------------------------------

model Meeting {
  id                Int           @id @default(autoincrement())
  title             String
  startsAt          DateTime
  durationMinutes   Int           @default(30)
  location          String?
  meetingLink       String?
  organizerId       Int
  status            MeetingStatus @default(PLANNED)
  notes             String?
  outcome           String?
  nextSteps         String?
  rescheduledFromId Int?          @unique

  leadId     Int?
  dealId     Int?
  customerId Int?
  companyId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer       User      @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  rescheduledFrom Meeting?  @relation("MeetingReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Meeting?  @relation("MeetingReschedule")
  lead            Lead?     @relation(fields: [leadId], references: [id])
  deal            Deal?     @relation(fields: [dealId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  company         Company?  @relation(fields: [companyId], references: [id])

  participants  MeetingParticipant[]
  followUpTasks Task[]               @relation("MeetingFollowUpTasks")

  @@index([startsAt])
  @@index([organizerId, startsAt])
  @@index([dealId])
  @@index([leadId])
  @@map("meetings")
}

// Participant is an internal user OR an external contact
model MeetingParticipant {
  id        Int  @id @default(autoincrement())
  meetingId Int
  userId    Int?
  contactId Int?

  meeting Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([meetingId])
  @@index([userId])
  @@map("meeting_participants")
}

// ---------------------------------------------------------------------
// 8. DOCUMENTS (files live in S3/disk; DB stores metadata + storage key)
// ---------------------------------------------------------------------

model Document {
  id             Int              @id @default(autoincrement())
  name           String
  category       DocumentCategory @default(OTHER)
  uploadedById   Int
  currentVersion Int              @default(1)

  leadId     Int?
  dealId     Int?
  customerId Int?
  companyId  Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  lead       Lead?     @relation(fields: [leadId], references: [id])
  deal       Deal?     @relation(fields: [dealId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])
  company    Company?  @relation(fields: [companyId], references: [id])

  versions DocumentVersion[]

  @@index([leadId])
  @@index([dealId])
  @@index([customerId])
  @@index([companyId])
  @@map("documents")
}

model DocumentVersion {
  id               Int      @id @default(autoincrement())
  documentId       Int
  versionNo        Int
  storageKey       String // path / object key
  originalFileName String
  fileType         String // pdf, docx, xlsx, png ...
  mimeType         String
  sizeBytes        BigInt
  checksum         String?
  uploadedById     Int
  uploadedAt       DateTime @default(now())
  replaceNote      String?

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

// ---------------------------------------------------------------------
// 9. REVENUE TARGETS
// Exactly one of userId / teamId is set (CHECK in DB_DESIGN.md)
// ---------------------------------------------------------------------

model RevenueTarget {
  id          Int          @id @default(autoincrement())
  userId      Int?
  teamId      Int?
  periodType  TargetPeriod
  periodStart DateTime     @db.Date
  periodEnd   DateTime     @db.Date
  amount      Decimal      @db.Decimal(14, 2)
  createdById Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee  User? @relation("TargetEmployee", fields: [userId], references: [id])
  team      Team? @relation(fields: [teamId], references: [id])
  createdBy User  @relation("TargetCreator", fields: [createdById], references: [id])

  changes TargetChange[]

  @@index([userId, periodStart])
  @@index([teamId, periodStart])
  @@map("revenue_targets")
}

model TargetChange {
  id          Int      @id @default(autoincrement())
  targetId    Int
  oldAmount   Decimal  @db.Decimal(14, 2)
  newAmount   Decimal  @db.Decimal(14, 2)
  changedById Int
  changedAt   DateTime @default(now())
  reason      String?

  target    RevenueTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  changedBy User          @relation(fields: [changedById], references: [id])

  @@index([targetId, changedAt])
  @@map("target_changes")
}

// ---------------------------------------------------------------------
// 10. IMPORTS (Excel / Google Sheets)
// ---------------------------------------------------------------------

model ImportBatch {
  id            Int               @id @default(autoincrement())
  source        ImportSource
  fileName      String?
  sheetRef      String? // Google Sheet id / tab name
  status        ImportBatchStatus @default(PROCESSING)
  totalRows     Int               @default(0)
  importedCount Int               @default(0)
  skippedCount  Int               @default(0)
  failedCount   Int               @default(0)
  uploadedById  Int
  startedAt     DateTime          @default(now())
  completedAt   DateTime?

  uploadedBy User        @relation(fields: [uploadedById], references: [id])
  rows       ImportRow[]

  @@index([uploadedById])
  @@map("import_batches")
}

model ImportRow {
  id        Int             @id @default(autoincrement())
  batchId   Int
  rowNumber Int
  status    ImportRowStatus
  reason    String? // why skipped / failed (duplicate of lead #12, invalid email, ...)
  rawData   Json

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lead  Lead?       @relation("ImportRowLead")

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("import_rows")
}

// ---------------------------------------------------------------------
// 11. NOTIFICATIONS & AUDIT
// ---------------------------------------------------------------------

model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int
  type       String // TASK_ASSIGNED, TASK_DUE, MEETING_REMINDER, ...
  title      String
  body       String?
  entityType String? // lead | deal | task | meeting ...
  entityId   Int?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// Append-only history: assignments, deal stages, task status, meeting outcomes, deal results
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    Int?
  action     String // CREATE, UPDATE, DELETE, ASSIGN, STAGE_CHANGE, EXPORT, ...
  entityType String
  entityId   Int
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}


model TaskRescheduleHistory {
  id             Int      @id @default(autoincrement())
  taskId         Int
  previousDueAt  DateTime
  newDueAt       DateTime
  rescheduledById Int
  note           String?
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_reschedule_history")
}

model EmailSetting {
  id              Int      @id @default(autoincrement())
  smtpHost        String   @default("")
  smtpPort        Int      @default(587)
  smtpSecure      Boolean  @default(false)
  smtpUser        String   @default("")
  smtpPass        String   @default("")
  fromEmail       String   @default("")
  fromName        String   @default("Sales CRM")
  isEnabled       Boolean  @default(false)
  notifyDeals     Boolean  @default(true)
  notifyDocuments Boolean  @default(true)
  notifyTargets   Boolean  @default(true)
  notifyFollowUps Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("email_settings")
}

model WhatsAppSetting {
  id               Int      @id @default(autoincrement())
  phoneNumberId    String   @default("")
  wabaId           String   @default("")
  accessToken      String   @default("")
  templateName     String   @default("crm_alert_notification")
  templateLanguage String   @default("en_US")
  isEnabled        Boolean  @default(false)
  notifyDeals      Boolean  @default(true)
  notifyDocuments  Boolean  @default(true)
  notifyTargets    Boolean  @default(true)
  notifyFollowUps  Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@map("whatsapp_settings")
}

model FacebookSetting {
  id              Int      @id @default(autoincrement())
  appId           String   @default("")
  appSecret       String   @default("")
  pageId          String   @default("")
  pageAccessToken String   @default("")
  verifyToken     String   @default("")
  defaultOwnerId  Int?
  isEnabled       Boolean  @default(false)
  notifyOwner     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  defaultOwner User? @relation("FacebookDefaultOwner", fields: [defaultOwnerId], references: [id])

  @@map("facebook_settings")
}

// ---------------------------------------------------------------------
// 12. CUSTOMER PROPOSALS
// ---------------------------------------------------------------------

model Proposal {
  id              Int            @id @default(autoincrement())
  proposalNumber  String         @unique
  title           String
  customerId      Int
  leadId          Int?
  dealId          Int?
  ownerId         Int
  createdById     Int
  status          ProposalStatus @default(DRAFT)
  currency        String         @default("USD")
  issueDate               DateTime       @default(now()) @db.Date
  validUntil              DateTime       @db.Date
  submittedForApprovalAt  DateTime?
  approvedAt              DateTime?
  approvedById            Int?
  approvalNote            String?        @db.Text
  sentAt                  DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?

  subtotal       Decimal      @default(0) @db.Decimal(14, 2)
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @default(0) @db.Decimal(14, 2)
  discountAmount Decimal      @default(0) @db.Decimal(14, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal      @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal      @default(0) @db.Decimal(14, 2)

  summary     String?   @db.Text
  terms       String?   @db.Text
  clientNotes String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer   Customer  @relation(fields: [customerId], references: [id])
  lead       Lead?     @relation(fields: [leadId], references: [id])
  deal       Deal?     @relation(fields: [dealId], references: [id])
  owner      User      @relation("ProposalOwner", fields: [ownerId], references: [id])
  createdBy  User      @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  approvedBy User?     @relation("ProposalApprovedBy", fields: [approvedById], references: [id])
  items      ProposalItem[]

  @@index([customerId])
  @@index([dealId])
  @@index([ownerId, status])
  @@index([status, validUntil])
  @@map("proposals")
}

model ProposalItem {
  id               Int      @id @default(autoincrement())
  proposalId       Int
  productServiceId Int?
  title            String
  description      String?  @db.Text
  quantity         Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(14, 2)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  taxRate          Decimal  @default(0) @db.Decimal(5, 2)
  total            Decimal  @db.Decimal(14, 2)
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  proposal       Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id])

  @@index([proposalId, position])
  @@map("proposal_items")
}

// ---------------------------------------------------------------------
// 10. EXPENSE & FINANCIAL TRANSACTIONS
// ---------------------------------------------------------------------

model FinancialTransaction {
  id              Int                      @id @default(autoincrement())
  type            FinancialTransactionType
  title           String                   @db.VarChar(255)
  amount          Decimal                  @db.Decimal(14, 2)
  category        String                   @db.VarChar(100)
  paymentMethod   TransactionPaymentMethod @default(BANK_TRANSFER)
  status          TransactionStatus        @default(COMPLETED)
  reference       String?                  @db.VarChar(100)
  transactionDate DateTime                 @default(now())
  description     String?                  @db.Text
  createdById     Int?
  customerId      Int?
  dealId          Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?

  createdBy User?     @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  invoicePayments InvoicePayment[]

  @@index([type])
  @@index([transactionDate])
  @@index([category])
  @@index([status])
  @@index([createdById])
  @@index([customerId])
  @@index([dealId])
  @@index([deletedAt])
  @@map("financial_transactions")
}

// ---------------------------------------------------------------------
// 11. INVOICE MANAGEMENT SYSTEM
// ---------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum InvoiceTaxType {
  INTRA_STATE // CGST + SGST
  INTER_STATE // IGST
  EXEMPT      // Zero tax / Export / Exempt
}

enum InvoiceTemplateEdition {
  MODERN_EXECUTIVE
  CLASSIC_CORPORATE
  MINIMALIST_CLEAN
  VIBRANT_TECH
}

model Invoice {
  id              Int                    @id @default(autoincrement())
  invoiceNumber   String                 @unique @db.VarChar(50)
  customerId      Int?
  dealId          Int?
  createdById     Int?
  status          InvoiceStatus          @default(DRAFT)
  issueDate       DateTime               @db.Date
  dueDate         DateTime               @db.Date
  currency        String                 @default("INR") @db.VarChar(10)
  taxType         InvoiceTaxType         @default(INTRA_STATE)
  templateEdition InvoiceTemplateEdition @default(MODERN_EXECUTIVE)

  subtotal      Decimal @db.Decimal(14, 2)
  totalDiscount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @db.Decimal(14, 2)
  amountPaid    Decimal @default(0) @db.Decimal(14, 2)
  amountDue     Decimal @db.Decimal(14, 2)

  notes          String?   @db.Text
  terms          String?   @db.Text
  pdfUrl         String?   @db.VarChar(500)
  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  cancelledAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments InvoicePayment[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([dealId])
  @@index([createdById])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id               Int      @id @default(autoincrement())
  invoiceId        Int
  productServiceId Int?
  itemName         String   @db.VarChar(255)
  hsnCode          String?  @db.VarChar(50)
  description      String?  @db.Text
  quantity         Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(14, 2)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent       Decimal  @default(18) @db.Decimal(5, 2)
  lineTotal        Decimal  @db.Decimal(14, 2)

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productServiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id                     Int                      @id @default(autoincrement())
  invoiceId              Int
  amount                 Decimal                  @db.Decimal(14, 2)
  paymentDate            DateTime                 @default(now())
  paymentMethod          TransactionPaymentMethod @default(BANK_TRANSFER)
  reference              String?                  @db.VarChar(100)
  notes                  String?                  @db.Text
  financialTransactionId Int?
  createdAt              DateTime                 @default(now())

  invoice              Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([financialTransactionId])
  @@map("invoice_payments")
}

model InvoiceSetting {
  id                   Int                    @id @default(autoincrement())
  companyName          String                 @default("Vibrantick Infotech Solutions") @db.VarChar(255)
  companyLogo          String?                @db.Text
  companyEmail         String                 @default("info@vibrantick.in") @db.VarChar(255)
  companyPhone         String                 @default("+91 8699792040") @db.VarChar(50)
  whatsappNumber       String                 @default("8699792040") @db.VarChar(50)
  addressLine1         String?                @db.VarChar(255)
  city                 String                 @default("Mohali") @db.VarChar(100)
  state                String                 @default("Punjab") @db.VarChar(100)
  country              String                 @default("India") @db.VarChar(100)
  pincode              String?                @db.VarChar(20)
  gstin                String?                @db.VarChar(30)
  panNumber            String?                @db.VarChar(20)
  bankName             String?                @db.VarChar(100)
  bankAccountNo        String?                @db.VarChar(50)
  bankIfsc             String?                @db.VarChar(30)
  bankBranch           String?                @db.VarChar(100)
  upiId                String?                @db.VarChar(100)
  invoicePrefix        String                 @default("VIS-INV-") @db.VarChar(20)
  nextNumber           Int                    @default(1001)
  defaultTemplate      InvoiceTemplateEdition @default(MODERN_EXECUTIVE)
  brandColor           String                 @default("#1d61e7") @db.VarChar(30)
  defaultNotes         String?                @db.Text
  defaultTerms         String?                @db.Text
  autoInvoiceOnDealWon Boolean                @default(true)
  autoSyncCashflow     Boolean                @default(true)
  updatedAt            DateTime               @updatedAt
  createdAt            DateTime               @default(now())

  @@map("invoice_settings")
}
